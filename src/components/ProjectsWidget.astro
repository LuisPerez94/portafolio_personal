---
interface GithubRepo {
    name: string;
    description: string;
    html_url: string;
    homepage: string;
    created_at: string;
    topics: string[];
    archived: boolean;
    languages_url: string;
}

// Función para obtener los repositorios
async function getGithubRepos(): Promise<GithubRepo[]> {
    try {
        const response = await fetch('https://api.github.com/users/LuisPerez94/repos');
        const repos = await response.json();
        return repos
            .filter((repo: GithubRepo) => (!repo.archived && repo.name !== 'LuisPerez94' && repo.name !== 'portafolio_personal'))
            .sort((a: GithubRepo, b: GithubRepo) => 
                new Date(b.created_at).getTime() - new Date(a.created_at).getTime()
            );
    } catch (error) {
        console.error('Error fetching repos:', error);
        return [];
    }
}

const repos = await getGithubRepos();
---

<div class="container mx-auto px-6 py-10">
    <h2 class="text-3xl font-bold text-[#95BF47] mb-12 text-center">Proyectos</h2>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 auto-rows-[250px]">
        {repos.map((repo, index) => (
            <div 
                class={`rounded-xl overflow-hidden relative group transition-all duration-500 
                    ${index === 0 ? 'md:col-span-2 md:row-span-2' : ''} 
                    ${index === 1 ? 'md:row-span-2' : ''}
                    ${index === 3 ? 'md:col-span-2' : ''}`}
                data-repo-name={repo.name}
                data-languages-url={repo.languages_url}
            >
                <div class="absolute inset-0 bg-gradient-to-b from-transparent to-black/60 z-10"></div>
                <div class="project-image absolute inset-0 bg-gray-800 transition-transform duration-500 group-hover:scale-110">
                </div>

                <div class="absolute inset-0 z-20 p-6 flex flex-col justify-end transform transition-transform duration-500">
                    <div class="transform translate-y-4 transition-transform duration-500 group-hover:translate-y-0">
                        <h3 class="text-xl font-bold text-white mb-2">{repo.name}</h3>
                        
                        <p class="text-gray-300 text-sm mb-3 opacity-0 transition-opacity duration-500 group-hover:opacity-100">
                            {repo.description || 'Sin descripción disponible'}
                        </p>

                        <div class="languages-container flex flex-wrap gap-2 mb-4 opacity-0 transition-opacity duration-500 group-hover:opacity-100">
                        </div>

                        <div class="flex flex-wrap gap-2 mb-4">
                            {repo.topics?.map((topic) => (
                                <span class="px-2 py-1 text-xs bg-[#95BF47]/20 text-[#95BF47] rounded-full">
                                    {topic}
                                </span>
                            ))}
                        </div>

                        <div class="flex gap-3 opacity-0 transition-opacity duration-500 group-hover:opacity-100">
                            <a 
                                href={repo.html_url}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="px-4 py-2 bg-[#95BF47] text-white rounded-full text-sm hover:bg-[#95BF47]/80 transition-colors"
                            >
                                Ver Código
                            </a>
                            {repo.homepage && (
                                <a 
                                    href={repo.homepage}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="px-4 py-2 bg-white/10 text-white rounded-full text-sm hover:bg-white/20 transition-colors"
                                >
                                    Demo
                                </a>
                            )}
                        </div>
                    </div>
                </div>
            </div>
        ))}
    </div>
</div>

<script>
    import { getCachedData, setCachedData } from '../utils/githubCache';
    const languageColors: Record<string, string> = {
        JavaScript: '#f1e05a',
        TypeScript: '#2b7489',
        HTML: '#e34c26',
        CSS: '#563d7c',
        Python: '#3572A5',
        Java: '#b07219',
        PHP: '#4F5D95',
    };

    async function fetchLanguages(languagesUrl: string, repoName: string): Promise<Record<string, number>> {
        const cacheKey = `repo_languages_${repoName}`;
        const cachedLanguages = getCachedData<Record<string, number>>(cacheKey);
        
        if (cachedLanguages) {
            return cachedLanguages;
        }

        try {
            const response = await fetch(languagesUrl);
            const languages = await response.json();
            setCachedData(cacheKey, languages);
            return languages;
        } catch (error) {
            console.error('Error fetching languages:', error);
            return {};
        }
    }

    function createLanguagePill(language: string, percentage: number): HTMLSpanElement {
        const pill = document.createElement('span');
        pill.className = 'px-2 py-1 text-xs rounded-full flex items-center gap-1';
        
        const dot = document.createElement('span');
        dot.className = 'w-2 h-2 rounded-full';
        dot.style.backgroundColor = languageColors[language] || '#808080';
        
        const text = document.createElement('span');
        text.textContent = `${language} ${percentage.toFixed(1)}%`;
        
        pill.appendChild(dot);
        pill.appendChild(text);
        pill.style.backgroundColor = `${languageColors[language]}`;
        pill.style.color = 'white';
        
        return pill;
    }

    function handleProjectHover(event: MouseEvent) {
        const projectCard = (event.currentTarget as HTMLElement);
        const languagesContainer = projectCard.querySelector('.languages-container');
        
        if (!languagesContainer || languagesContainer.children.length > 0) return;

        const languagesUrl = projectCard.dataset.languagesUrl;
        const repoName = projectCard.dataset.repoName;

        if (!languagesUrl || !repoName) return;

        fetchLanguages(languagesUrl, repoName).then(languages => {
            const total = Object.values(languages).reduce((a, b) => a + b, 0);
            
            languagesContainer.innerHTML = '';
            Object.entries(languages).forEach(([language, bytes]) => {
                const percentage = (bytes / total) * 100;
                const pill = createLanguagePill(language, percentage);
                languagesContainer.appendChild(pill);
            });
        });
    }

    document.addEventListener('DOMContentLoaded', () => {
        const projectCards = document.querySelectorAll('[data-repo-name]');
        projectCards.forEach(card => {
            card.addEventListener('mouseenter', handleProjectHover);
        });
    });
</script>

<style>
    .project-image {
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        background-image: linear-gradient(45deg, #1a1a1a, #2a2a2a);
        filter: brightness(0.7);
    }

    [data-repo-name="PokemonSelector"] .project-image {
        background-image: url('/pokemon.png');
    }
    [data-repo-name="angular_store"] .project-image {
        background-image: url('/store.png');
    }
</style> 