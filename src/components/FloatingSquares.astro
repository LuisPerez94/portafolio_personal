---
---

<div class="floating-squares-container" aria-hidden="true">
    {Array.from({ length: 15 }).map((_, i) => (
        <div class="floating-square"></div>
    ))}
</div>

<style>
.floating-squares-container {
    position: fixed;
    bottom: -100px;
    left: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    z-index: 0;
    pointer-events: none;
}

.floating-square {
    position: absolute;
    bottom: -100px;
    background: rgba(149, 191, 71, 0.1);
    backdrop-filter: blur(2px);
    border-radius: 20px;
    animation: float-up var(--duration) linear infinite;
    opacity: 0.4;
}

.floating-square:nth-child(1) { --size: 60px; left: 10%; --duration: 15s; --delay: 0s; }
.floating-square:nth-child(2) { --size: 85px; left: 20%; --duration: 18s; --delay: 2s; }
.floating-square:nth-child(3) { --size: 45px; left: 30%; --duration: 12s; --delay: 4s; }
.floating-square:nth-child(4) { --size: 70px; left: 40%; --duration: 16s; --delay: 0s; }
.floating-square:nth-child(5) { --size: 90px; left: 50%; --duration: 20s; --delay: 3s; }
.floating-square:nth-child(6) { --size: 55px; left: 60%; --duration: 14s; --delay: 2s; }
.floating-square:nth-child(7) { --size: 75px; left: 70%; --duration: 17s; --delay: 1s; }
.floating-square:nth-child(8) { --size: 50px; left: 80%; --duration: 13s; --delay: 4s; }
.floating-square:nth-child(9) { --size: 80px; left: 90%; --duration: 19s; --delay: 2s; }
.floating-square:nth-child(10) { --size: 65px; left: 15%; --duration: 15s; --delay: 1s; }
.floating-square:nth-child(11) { --size: 95px; left: 25%; --duration: 21s; --delay: 3s; }
.floating-square:nth-child(12) { --size: 40px; left: 35%; --duration: 11s; --delay: 0s; }
.floating-square:nth-child(13) { --size: 85px; left: 45%; --duration: 18s; --delay: 2s; }
.floating-square:nth-child(14) { --size: 50px; left: 55%; --duration: 13s; --delay: 4s; }
.floating-square:nth-child(15) { --size: 70px; left: 65%; --duration: 16s; --delay: 1s; }

.floating-square::before {
    content: '';
    position: absolute;
    width: var(--size);
    height: var(--size);
    background: inherit;
    border-radius: inherit;
    animation: rotate var(--duration) linear infinite;
    animation-delay: var(--delay);
}

@keyframes float-up {
    0% {
        transform: translateY(0) rotate(0deg);
        opacity: 0;
    }
    10% {
        opacity: 0.4;
    }
    90% {
        opacity: 0.4;
    }
    100% {
        transform: translateY(-100vh) rotate(360deg);
        opacity: 0;
    }
}

@keyframes rotate {
    from {
        transform: rotate(0deg);
    }
    to {
        transform: rotate(360deg);
    }
}

.floating-square:nth-child(3n) {
    background: rgba(255, 255, 255, 0.05);
}

.floating-square:nth-child(3n + 1) {
    background: rgba(149, 191, 71, 0.08);
}

.floating-square:nth-child(3n + 2) {
    background: rgba(73, 209, 255, 0.05);
}

.floating-square:nth-child(5n)::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(
        45deg,
        transparent 0%,
        rgba(255, 255, 255, 0.1) 50%,
        transparent 100%
    );
    border-radius: inherit;
}
</style> 