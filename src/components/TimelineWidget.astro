---
interface Experience {
    date: string;
    name: string;
    position: string;
    description: string[];
    technologies: string[];
    specialism: string[];
}

const experienceData = (await import('../information/information.json')).default.experience;
---

<div class="relative container mx-auto px-6 py-10">
    <h2 class="text-3xl font-bold text-[#95BF47] mb-12 text-center">Experiencia Laboral</h2>
    
    <div class="relative wrap overflow-hidden">
        <div class="absolute h-full w-1 bg-[#95BF47] left-1/2 transform -translate-x-1/2"></div>

        {experienceData.map((exp: Experience, index: number) => (
            <div class={`mb-8 flex justify-between items-center w-full ${index % 2 === 0 ? 'flex-row-reverse' : ''}`}>
                <div class="order-1 w-5/12"></div>
                <div class="z-20 flex items-center order-1 bg-[#95BF47] shadow-xl w-8 h-8 rounded-full">
                    <h1 class="mx-auto font-semibold text-lg text-white">{index + 1}</h1>
                </div>
                <div class={`order-1 w-5/12 px-6 py-4 rounded-lg shadow-xl bg-white/10 backdrop-blur-md border border-white/20 ${index % 2 === 0 ? 'text-right' : 'text-left'}`}>
                    <h3 class="mb-3 font-bold text-white text-xl">{exp.name}</h3>
                    <h4 class="mb-3 text-[#95BF47] text-base font-semibold">{exp.position}</h4>
                    <p class="text-sm text-gray-300 mb-3">{exp.date}</p>
                    <ul class="text-sm text-gray-300 mb-4 list-disc pl-4">
                        {exp.description.map((desc) => (
                            <li class="mb-2">{desc}</li>
                        ))}
                    </ul>
                    <div class="mb-3">
                        <p class="text-[#95BF47] font-semibold mb-2">Tecnologías:</p>
                        <div class="flex flex-wrap gap-2 justify-start">
                            {exp.technologies.map((tech) => (
                                <span class="px-2 py-1 text-xs bg-white/5 rounded-full text-gray-300">{tech}</span>
                            ))}
                        </div>
                    </div>
                    <div>
                        <p class="text-[#95BF47] font-semibold mb-2">Especialidades:</p>
                        <div class="flex flex-wrap gap-2 justify-start">
                            {exp.specialism.map((spec) => (
                                <span class="px-2 py-1 text-xs bg-white/5 rounded-full text-gray-300">{spec}</span>
                            ))}
                        </div>
                    </div>
                </div>
            </div>
        ))}
    </div>
</div>

<style>
    .wrap::before {
        content: "";
        position: absolute;
        width: 100%;
        height: 100%;
        background: radial-gradient(50% 50% at 50% 50%, rgba(149, 191, 71, 0.1) 0%, rgba(149, 191, 71, 0) 100%);
        pointer-events: none;
    }
</style>